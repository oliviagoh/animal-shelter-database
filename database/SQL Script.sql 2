ALTER SESSION SET NLS_DATE_FORMAT='YYYY-MM-DD';
ALTER SESSION SET NLS_TIMESTAMP_FORMAT = 'YYYY-MM-DD HH24:MI';

DROP TABLE Health_History CASCADE CONSTRAINTS;
DROP TABLE Donations CASCADE CONSTRAINTS;
DROP TABLE Tasks CASCADE CONSTRAINTS;
DROP TABLE Adoptions CASCADE CONSTRAINTS;
DROP TABLE Adopters CASCADE CONSTRAINTS;
DROP TABLE Veterinarians CASCADE CONSTRAINTS;
DROP TABLE Staff CASCADE CONSTRAINTS;
DROP TABLE Animals CASCADE CONSTRAINTS;

CREATE TABLE Animals (
    animal_id NUMERIC(9) PRIMARY KEY,
    animal_name VARCHAR2(30) NOT NULL,
    species VARCHAR2(30) NOT NULL,
    breed VARCHAR2(30),
    gender CHAR(1) NOT NULL CHECK (gender IN ('M','F')),
    age NUMERIC(2) NOT NULL CHECK (age BETWEEN 0 AND 30),
    rescue_date DATE NOT NULL,
    status VARCHAR2(20) NOT NULL CHECK (status IN ('Available', 'Adopted', 'Under Treatments'))
);

CREATE TABLE Staff (
    staff_id NUMERIC(9) PRIMARY KEY,
    staff_name VARCHAR2(50) NOT NULL,
    staff_DOB DATE NOT NULL,
    staff_tel VARCHAR2(13) UNIQUE NOT NULL,
    staff_email VARCHAR2(40) UNIQUE CHECK (staff_email LIKE '%@%.%'),
    hire_date DATE NOT NULL,
    staff_position VARCHAR2(50) NOT NULL,
    staff_shift VARCHAR2(50) NOT NULL
);

CREATE TABLE Veterinarians (
    vet_id NUMERIC(9) PRIMARY KEY,
    vet_name VARCHAR2(30) NOT NULL,
    vet_phone_number VARCHAR2(13)
);

CREATE TABLE Adopters (
    adopter_id NUMERIC(9) PRIMARY KEY,
    adopter_name VARCHAR2(50) NOT NULL,
    adopter_dob DATE NOT NULL,
    adopter_tel VARCHAR2(13) NOT NULL,
    adopter_address VARCHAR2(50) NOT NULL,
    adopter_email VARCHAR2(40),
    CONSTRAINT chk_email_format CHECK (REGEXP_LIKE(adopter_email, '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'))
);

CREATE TABLE Adoptions (
    adoption_id NUMERIC(9) PRIMARY KEY,
    animal_id NUMERIC(9) NOT NULL,
    adopter_id NUMERIC(9) NOT NULL,
    date_of_adoption DATE,
    adoption_status VARCHAR2(10) NOT NULL,
    FOREIGN KEY (animal_id) REFERENCES Animals(animal_id),
    FOREIGN KEY (adopter_id) REFERENCES Adopters(adopter_id),
    CONSTRAINT uq_animal_adoption UNIQUE (animal_id)
);

CREATE TABLE Tasks (
    task_id NUMERIC(9) PRIMARY KEY,
    animal_id NUMERIC(9) NOT NULL,
    staff_id NUMERIC(9) NOT NULL,
    task_name VARCHAR2(30) NOT NULL,
    task_date_time TIMESTAMP NOT NULL,
    FOREIGN KEY (animal_id) REFERENCES Animals(animal_id),
    FOREIGN KEY (staff_id) REFERENCES Staff(staff_id),
    CONSTRAINT unique_task_assignment UNIQUE (animal_id, staff_id, task_date_time)
);

CREATE TABLE Donations (
    donation_id NUMERIC(9) PRIMARY KEY,
    staff_id NUMERIC(9),
    supporter_name VARCHAR2(50),
    donation_type VARCHAR2(50) NOT NULL,
    donation_method VARCHAR2(8) NOT NULL CHECK (donation_method IN ('Physical', 'Online')),
    amount NUMERIC(10,2) NOT NULL CHECK (amount>0),
    donation_date DATE NOT NULL,
    FOREIGN KEY (staff_id) REFERENCES Staff(staff_id)
);

CREATE TABLE Health_History ( 
    record_id NUMERIC(10) PRIMARY KEY,  
    animal_id NUMERIC(9), 
    vet_id NUMERIC(9), 
    check_up_date DATE NOT NULL, 
    diagnosis VARCHAR2(50) NOT NULL,  
    treatment VARCHAR2(50) NOT NULL, 
    health_check_rating NUMERIC(2,1) NOT NULL CHECK (health_check_rating BETWEEN 0 AND 5), 
    FOREIGN KEY (animal_id) REFERENCES Animals(animal_id), 
    FOREIGN KEY (vet_id) REFERENCES Veterinarians(vet_id) 
); 

