--QUERIES 
--A query that requires an outer join 
SELECT A.animal_name AS "Animal Name", 
    H.diagnosis AS "Diagnosis",  
    V.vet_name AS "Vet Name", 
    H.treatment AS "Treatment" 
FROM Animals A  
FULL OUTER JOIN Health_History H ON A.animal_id = H.animal_id 
FULL OUTER JOIN Veterinarians V ON H.vet_id = V.vet_id  
ORDER BY A.animal_name ASC;  

--A minimum 4 table join with a group by function query. 
SELECT A.animal_name AS "Animal Name",   
    UPPER(AD.adoption_status) AS "Adoption Status",   
    ADS.adopter_name AS "Adopter Name",  
    COUNT(*) AS "Total Check-ups for Animal",  
    MAX(H.check_up_date) AS "Most recent animal check-up"  
FROM Animals A   
JOIN Health_History H ON A.animal_id = H.animal_id  
JOIN Adoptions AD ON AD.animal_id = A.animal_id   
JOIN Adopters ADS ON AD.adopter_id = ADS.adopter_id  
GROUP BY A.animal_name, AD.adoption_status, ADS.adopter_name  
ORDER BY A.animal_name ASC;
 

--A string pattern matching and date function query 
SELECT animal_name AS "Animal Name",   
    species AS "Species",   
    breed AS "Breed",   
    gender AS "Gender",   
    TO_CHAR(rescue_date, 'YYYY-MM-DD') AS "Rescue Date"  
FROM Animals   
WHERE gender LIKE 'M'  
  AND rescue_date BETWEEN TO_DATE('2023-01-01', 'YYYY-MM-DD')   
  AND TO_DATE('2025-12-01', 'YYYY-MM-DD')  
ORDER BY rescue_date ASC;   

--A query having both OR and AND 
SELECT 
    A.animal_id AS "Animal ID", 
    A.animal_name AS "Animal name",
    A.species AS "Species", 
    A.status AS "Status", 
    H.health_check_rating AS "Health-check rating", 
    TO_CHAR(H.check_up_date, 'YYYY-MM-DD') AS "Last checkup"
FROM Animals A 
JOIN Health_History H ON A.animal_id = H.animal_id
WHERE (A.status = 'Under Treatments' AND H.health_check_rating < 3) OR (A.species = 'Dog' AND A.age > 3 AND H.health_check_rating >= 4) 
ORDER BY H.health_check_rating DESC; 

--A query that consists of at least 2 subqueries. 
SELECT
    S.staff_id AS "Staff ID",
    S.staff_name AS "Staff name",
    S.staff_position AS "Staff position", 
    (SELECT COUNT(*) FROM Tasks T WHERE T.staff_id = S.staff_id) AS "Total tasks", 
    (SELECT COUNT(DISTINCT animal_id) FROM Tasks T WHERE T.staff_id = S.staff_id) AS "Unique animals cared for" 
FROM Staff S 
WHERE S.staff_id IN (
    SELECT staff_id 
    FROM Tasks 
    WHERE task_date_time > TO_DATE('2025-07-01', 'YYYY-MM-DD')
    ) 
    AND 
    S.staff_id IN ( 
    SELECT staff_id 
    FROM Donations 
    WHERE donation_date > TO_DATE('2020-01-01', 'YYYY-MM-DD') 
    ) 
ORDER BY "Total tasks" DESC; 
 
-- Answer the following question based on your chosen scenario. 
SELECT 
    A.animal_id AS "Animal ID", 
    A.animal_name AS "Animal name", 
    A.species AS "Species", 
    A.breed AS "Breed", 
    TO_CHAR(A.rescue_date, 'YYYY-MM-DD') AS rescue_date, 
    ROUND(AVG(H.health_check_rating), 1) AS avg_health_rating, 
    COUNT(H.record_id) AS number_of_checkups
FROM Animals A 
JOIN Health_History H ON A.animal_id = H.animal_id 
WHERE 
A.rescue_date < ADD_MONTHS(SYSDATE, -12) 
AND A.status != 'Adopted'
GROUP BY A.animal_id, A.animal_name, A.species, A.breed, A.rescue_date 
HAVING AVG(H.health_check_rating) >= 4
           AND COUNT(H.record_id) >= 2 
ORDER BY avg_health_rating DESC, number_of_checkups DESC; 